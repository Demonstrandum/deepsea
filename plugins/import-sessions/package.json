{
  "name": "@deepsea/import-sessions",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSea plugin: /import-claude, /import-pi and /import-dsh bring Claude Code and pi transcripts, and sessions of another home or backup, into real, resumable sessions: a chooser on the device or the server's own store, a workspace → session tree with directory-matched destinations, a compacted working session for large transcripts, all written through the harness's own persistence, attachment and workspace services.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "host/*.mjs",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "PROTOCOL.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "deepsea": {
    "requires": [
      "session-relocation",
      "command-claim-decoration",
      "modal-width"
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && for f in host/*.mjs; do node --check $f || exit 1; done && node --test tests/*.test.mjs",
    "prepare": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../harness/vendor/cordis",
    "@deepseek-ai/dsh-home-paths": "link:../../harness/packages/util/home-paths",
    "@deepseek-ai/dsh-session-format-catalog": "link:../../harness/packages/session/session-format-catalog",
    "@deepseek-ai/dsh-session-log-export": "link:../../harness/packages/session-query/session-log-export",
    "@deepseek-ai/dsh-session-persistence-jsonl": "link:../../harness/packages/session/session-persistence-jsonl",
    "@deepseek-ai/schemastery": "link:../../harness/vendor/schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "link:../../harness/packages/api/session-controller",
    "@deepseek-ai/dsh-client-connection": "link:../../harness/packages/client/connection",
    "@deepseek-ai/dsh-client-ui-commands": "link:../../harness/packages/client/ui-commands",
    "@deepseek-ai/dsh-client-ui-layout": "link:../../harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-session-persistence": "link:../../harness/packages/session/session-persistence",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  },
  "license": "MIT"
}
