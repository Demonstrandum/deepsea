{
  "name": "@deepsea/scripted-model",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSea plugin: a deterministic model whose replies are scripted by the prompt (JSONL commands: say, think, tool, expect, sleep, usage, error, end, title), for testing.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "adapter.mjs",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "link:../../harness/packages/llm/llm",
    "@deepsea/script": "link:../../packages/script"
  }
}
