{
  "name": "@deepsea/import-api-keys",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSea plugin: /import-api-keys, a browser command that opens the file picker on the machine you are at, reads pi's auth.json, another home's .credentials.yaml, a JSON key map or a .env file, shows which keys are new, unchanged or would be replaced, stores the ticked ones as credentials of the server and switches their providers on.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "parse.mjs",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "deepsea": {
    "requires": [
      "modal-width"
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check parse.mjs && node --test tests/*.test.mjs",
    "prepare": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "link:../../harness/packages/credentials/credentials"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../harness/vendor/cordis",
    "@deepseek-ai/dsh-api-remotes": "link:../../harness/packages/api/remotes",
    "@deepseek-ai/dsh-client-connection": "link:../../harness/packages/client/connection",
    "@deepseek-ai/dsh-client-ui-commands": "link:../../harness/packages/client/ui-commands",
    "@deepseek-ai/dsh-client-ui-layout": "link:../../harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../harness/packages/client/ui-slots",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  },
  "license": "MIT"
}
