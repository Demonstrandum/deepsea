{
  "name": "@deepsea/billing",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSea plugin: per-session billing in the composer (cost, plan quota, request counts), a /billing report, and a durable per-session store priced from provider receipts, quota headers and the harness's catalog prices.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "*.js",
    "*.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "deepsea": {
    "requires": [
      "billing-metadata"
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --test tests/*.test.mjs",
    "prepare": "node build.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../harness/vendor/cordis",
    "@deepseek-ai/dsh-client-ui-chat": "link:../../harness/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../harness/packages/client/ui-primitives",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "link:../../harness/packages/util/home-paths"
  }
}
