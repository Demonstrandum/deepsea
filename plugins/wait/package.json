{
  "name": "@deepsea/wait",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSea plugin: a `wait` tool in place of bash `sleep N`. The tool is told how long it waits, so the chat draws the call as a live progress bar with Skip (return early, as if the time had elapsed) and Abort (fail with \"user aborted sleep\", so the model stops and asks).",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "wait.mjs",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check wait.mjs && node --test tests/*.test.mjs",
    "prepare": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "link:../../harness/packages/llm/llm",
    "@deepseek-ai/dsh-tools": "link:../../harness/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../../harness/vendor/schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../harness/vendor/cordis",
    "@deepseek-ai/dsh-client-ui-chat": "link:../../harness/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "link:../../harness/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-tool": "link:../../harness/packages/client/ui-tool",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  },
  "license": "MIT"
}
